rules_version = '2';

// userId est l'UID Firebase du compte connecté, vérifié par Firebase via
// request.auth.uid : chacun ne peut écrire que dans ses propres documents.
// Lecture ouverte à tout compte connecté, pour la page "Amis" (voir la fiche
// et la collection des autres). Une carte obtenue est définitive : pas de
// update/delete depuis le client.
service cloud.firestore {
  match /databases/{database}/documents {
    // Fiche publique d'un joueur (nom, photo, nombre de cartes).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(["name", "photoURL", "updatedAt", "cardCount"]);
      allow delete: if false;

      match /cards/{cardId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId
                      && request.resource.data.keys().hasAll(["name", "rarityKey", "packedAt"])
                      && request.resource.data.name is string
                      && request.resource.data.rarityKey is string;
        allow update, delete: if false;
      }
    }
  }
}
