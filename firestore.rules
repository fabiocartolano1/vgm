rules_version = '2';

// Avec Firebase Auth, userId est l'UID du compte connecté et request.auth.uid
// est vérifié cryptographiquement par Firebase : personne ne peut écrire dans
// la collection de quelqu'un d'autre en se contentant de choisir son nom,
// contrairement à l'ancien menu déroulant. Toujours pas de update/delete
// depuis le client (une carte obtenue est définitive) et champs de base
// obligatoires sur la création.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/cards/{cardId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(["name", "rarityKey", "packedAt"])
                    && request.resource.data.name is string
                    && request.resource.data.rarityKey is string;
      allow update, delete: if false;
    }
  }
}
