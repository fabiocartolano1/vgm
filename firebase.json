{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-debug.log",
      "apikey.txt",
      "consoles.txt",
      "projet.md",
      "wikimaster.txt",
      "firestore.rules",
      "firestore.indexes.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "headers": [
    {
      "source": "**/*.@(html|js|css)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
